ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Request-code-access emails (Resend)
RESEND_API_KEY=
ACCESS_REQUEST_TO_EMAIL=
