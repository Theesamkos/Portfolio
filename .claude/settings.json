{
  "permissions": {
    "allow": [
      "Read(./.env.example)",
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm e2e)",
      "Bash(pnpm eval)",
      "Bash(npm view:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(pnpm add:*)",
      "Bash(git push:*)",
      "Bash(vercel:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(**/.env.local)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
